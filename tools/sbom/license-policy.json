  "rules": {
    "$comment": "linked — compiled into the products of ALMI and of partners (the DL module): only permissive; application — our server, console and keytool as delivered (images, bundle): weak copyleft with its obligations; os — packages of the base images, separate programs aggregated with ours; dev — tools of development, tests and CI, not delivered.",
    "linked": {
      "permissive": "ok",
      "weak-copyleft": "fail",
      "strong-copyleft": "fail",
      "network-copyleft": "fail",
      "not-open": "fail",
      "unknown": "fail"
    },
    "application": {
      "permissive": "ok",
      "weak-copyleft": "obligation",
      "strong-copyleft": "fail",
      "network-copyleft": "fail",
      "not-open": "fail",
      "unknown": "fail"
    },
    "os": {
      "permissive": "ok",
      "weak-copyleft": "obligation",
      "strong-copyleft": "obligation",
      "network-copyleft": "review",
      "not-open": "review",
      "unknown": "review"
    },
    "dev": {
      "permissive": "ok",
      "weak-copyleft": "ok",
      "strong-copyleft": "ok",
      "network-copyleft": "review",
      "not-open": "review",
      "unknown": "review"
    }
  },
  "obligations": {
    "weak-copyleft": "библиотека используется без изменений и загружается динамически (модуль Python, разделяемая библиотека); текст лицензии — в notices артефакта; исходный код библиотеки той же версии предоставляется по запросу получателя комплекта (LGPL, раздел 6) или берётся из указанного в SBOM источника.",
    "strong-copyleft": "только пакеты ОС базовых образов — отдельные программы, с нашим кодом не связываются; исходные тексты пакетов доступны в архиве Debian (snapshot.debian.org) по версии из SBOM; тексты лицензий — /usr/share/doc/<пакет>/copyright в образе. Комплект изолированного контура передаёт образы без изменений."
  },
