# Embedded trust roots (docs/specs/07-environments.md, section 3).
# Test and production keys never mix: one LM_TRUST_ROOTS set per build.
if(NOT LM_TRUST_ROOTS MATCHES "^(dev|ci|test|staging|prod)$")
  message(FATAL_ERROR "LM_TRUST_ROOTS must be one of dev, ci, test, staging, prod; got '${LM_TRUST_ROOTS}'")
endif()

if(LM_TRUST_ROOTS STREQUAL "dev" AND NOT LM_TRUST_ROOTS_FILE)
  set(LM_TRUST_ROOTS_FILE "${CMAKE_CURRENT_SOURCE_DIR}/../../contracts/vectors/keys/dev-root.pub")
  if(NOT EXISTS "${LM_TRUST_ROOTS_FILE}")
    message(WARNING "dev-root.pub is generated by E00-04 and does not exist yet; no trust roots embedded")
    set(LM_TRUST_ROOTS_FILE "")
  endif()
elseif(LM_TRUST_ROOTS STREQUAL "ci" AND NOT LM_TRUST_ROOTS_FILE)
  message(WARNING "LM_TRUST_ROOTS=ci without LM_TRUST_ROOTS_FILE (ci-root is generated per run from E00-04); "
                  "no trust roots embedded")
elseif(NOT LM_TRUST_ROOTS_FILE)
  message(FATAL_ERROR "LM_TRUST_ROOTS=${LM_TRUST_ROOTS} requires LM_TRUST_ROOTS_FILE")
endif()

set(LM_TRUST_ROOTS_DATA "")
set(LM_TRUST_ROOTS_KID "" CACHE STRING "kid of a bare embedded key; default: key file name without extension")
if(LM_TRUST_ROOTS_FILE)
  if(NOT EXISTS "${LM_TRUST_ROOTS_FILE}")
    message(FATAL_ERROR "LM_TRUST_ROOTS_FILE not found: ${LM_TRUST_ROOTS_FILE}")
  endif()
  file(READ "${LM_TRUST_ROOTS_FILE}" LM_TRUST_ROOTS_DATA)
  if(NOT LM_TRUST_ROOTS_KID)
    get_filename_component(LM_TRUST_ROOTS_KID "${LM_TRUST_ROOTS_FILE}" NAME_WE)
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LM_TRUST_ROOTS_FILE}")
endif()

configure_file("${CMAKE_CURRENT_SOURCE_DIR}/src/trust_roots_data.h.in"
               "${CMAKE_BINARY_DIR}/generated/lm/trust_roots_data.h" @ONLY)
message(STATUS "Trust roots: ${LM_TRUST_ROOTS} (${LM_TRUST_ROOTS_FILE})")
