# Settings of the local server (install.sh copies this file to .env once; edit .env, not this file).
# Version of the images in images/ of the bundle.
ALMI_VERSION=0.1.0
# Name of the server in the customer network: products and the console use https://SERVER_NAME.
SERVER_NAME=license.example.local
HTTPS_PORT=443
# Public keys of the ALMI trust roots, "kid:pub" separated by commas (filled by the bundle build).
TRUST_ROOTS=
LOG_LEVEL=INFO
# Limits per IP address (section 4.7 of document 2), raised for devices behind one NAT; 0 turns off.
# RATE_LIMIT_ACTIVATE_IP=100
# RATE_LIMIT_CHECK_IP=1000
# RATE_LIMIT_OFFLINE_IP=100
# Captcha of the offline portal after this many files from one address an hour; 0 turns off.
# OFFLINE_CAPTCHA_AFTER=50
