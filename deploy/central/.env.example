# Settings of the central server (install.sh copies this file to .env once; edit .env).
# Version tag of the images built by install.sh / upgrade.sh.
ALMI_VERSION=0.6.0
# Public name of the server: products, local servers and the console use https://SERVER_NAME.
SERVER_NAME=license.example.ru
HTTPS_PORT=443
# Public keys of the ALMI trust roots, "kid:pub" separated by commas. A trial installation with
# the public dev keys of the repository (DEV_ISSUER=1 ./install.sh) fills the dev root itself.
TRUST_ROOTS=
# The trust bundle of almi-keytool export-trust (GET /api/v1/trust): put it into ./trust/trust.json.
TRUST_BUNDLE_FILE=/etc/almi/trust/trust.json
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
DATABASE_POOL_MAX_SIZE=10
