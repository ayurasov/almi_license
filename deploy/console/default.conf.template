# The console SPA and /api proxied to the server, so the session cookie stays same-origin.
# The upstream is resolved per request (Docker DNS or NGINX_RESOLVER), so the console starts
# before the API and answers 502 for /api until it is up.
server {
    listen 80;
    root /usr/share/nginx/html;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api ${API_UPSTREAM};

    # add_header in a location drops the server-level ones, so every location repeats them.
    location /api/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }
}
