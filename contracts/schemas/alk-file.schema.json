{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://license.alter-os.ru/schemas/v1/alk-file.schema.json",
  "title": "AlkFile",
  "description": "Офлайн-файл: UTF-8 JSON-обёртка с подписанным содержимым (документ 2, раздел 10).",
  "type": "object",
  "required": [
    "format",
    "version",
    "payload"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "alk-req",
        "alk-lic",
        "alk",
        "alk-usage"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "payload": {
      "type": "string",
      "description": "Компактный JWS"
    }
  },
  "additionalProperties": true
}
